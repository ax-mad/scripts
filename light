#!/usr/bin/env bash
set -uo pipefail

# =============================================================================
# light - fast, reliable DDC/CI brightness setter
#
#   light <0-100>            set brightness on every detected display
#   light <0-100> <display>  set brightness on one ddcutil display number only
#
# DDC/CI runs over I2C, a bus with no error correction that cannot tolerate
# concurrent access. Displays are therefore set ONE AT A TIME, never in
# parallel. Every write is verified by reading the value back from the
# monitor itself (not by trusting ddcutil's exit code), and retried once if
# the readback doesn't match what was requested.
# =============================================================================

usage() {
  echo "Usage: light <0-100> [display_number]" >&2
  exit 1
}

[ $# -ge 1 ] && [ $# -le 2 ] || usage
[[ "$1" != "-h" && "$1" != "--help" ]] || usage

VAL="$1"
if ! [[ "$VAL" =~ ^[0-9]+$ ]] || [ "$VAL" -gt 100 ]; then
  echo "ERROR: brightness must be an integer between 0 and 100." >&2
  exit 1
fi

if ! command -v ddcutil &>/dev/null; then
  echo "ERROR: 'ddcutil' is not installed." >&2
  exit 1
fi

sudo -v || exit 1

# Escape hatch for flaky hardware: slows down ddcutil's internal DDC/CI
# timing. Try this before assuming the script is broken again, e.g.:
#   LIGHT_SLEEP_MULTIPLIER=2 light 80
SLEEP_ARGS=()
if [ -n "${LIGHT_SLEEP_MULTIPLIER:-}" ]; then
  SLEEP_ARGS=(--sleep-multiplier "$LIGHT_SLEEP_MULTIPLIER")
fi

if [ $# -eq 2 ]; then
  TARGET="$2"
  [[ "$TARGET" =~ ^[0-9]+$ ]] || usage
  TARGETS="$TARGET"
else
  TARGETS=$(sudo ddcutil detect --brief 2>/dev/null | grep -oE '^Display [0-9]+' | grep -oE '[0-9]+')
  if [ -z "$TARGETS" ]; then
    echo "ERROR: no DDC/CI capable displays detected." >&2
    exit 1
  fi
fi

get_current() {
  sudo ddcutil "${SLEEP_ARGS[@]}" --display "$1" getvcp 10 2>/dev/null \
    | sed -n 's/.*current value = *\([0-9]\+\).*/\1/p'
}

set_one() {
  local num="$1"

  sudo ddcutil "${SLEEP_ARGS[@]}" --display "$num" setvcp 10 "$VAL" &>/dev/null
  sleep 0.3
  if [ "$(get_current "$num")" = "$VAL" ]; then
    echo "Display $num -> ${VAL}%"
    return 0
  fi

  # Readback didn't match, whether or not ddcutil claimed success. Retry once.
  sleep 0.3
  sudo ddcutil "${SLEEP_ARGS[@]}" --display "$num" setvcp 10 "$VAL" &>/dev/null
  sleep 0.3
  local actual
  actual=$(get_current "$num")
  if [ "$actual" = "$VAL" ]; then
    echo "Display $num -> ${VAL}% (after retry)"
    return 0
  fi

  echo "Display $num: FAILED (currently at ${actual:-unknown}%)" >&2
  return 1
}

STATUS=0
for num in $TARGETS; do
  # Sequential on purpose. See header comment.
  set_one "$num" || STATUS=1
done

exit "$STATUS"
