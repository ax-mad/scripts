#!/usr/bin/env bash
set -e

echo "==> Restoring Qt6/QML dependencies for Quickshell/Pikabar..."

pikman update

pikman install \
    qml6-module-qtcore \
    qml6-module-qtqml \
    qml6-module-qtqml-models \
    qml6-module-qtqml-workerscript \
    qml6-module-qtnetwork \
    qml6-module-qtquick \
    qml6-module-qtquick-controls \
    qml6-module-qtquick-dialogs \
    qml6-module-qtquick-layouts \
    qml6-module-qtquick-templates \
    qml6-module-qtquick-window \
    qml6-module-qtquick-shapes \
    qml6-module-qtquick-tooling \
    qml6-module-qt-labs-folderlistmodel \
    qml6-module-qt-labs-qmlmodels \
    qml6-module-org-kde-ki18n \
    qml6-module-org-kde-kitemmodels \
    qml6-module-org-kde-kquickcontrols \
    qml6-module-org-kde-kquickcontrolsaddons \
    qml6-module-org-kde-ksvg \
    qml6-module-org-kde-kwindowsystem \
    qml6-module-org-kde-kirigami \
    qml6-module-org-kde-newstuff \
    qml6-module-org-kde-notifications \
    qml6-module-org-kde-plasma-plasma5support \
    qt6-svg-plugins \
    libqt6svg6

echo "==> Checking package configuration..."
sudo dpkg --configure -a

echo "==> Fixing any broken dependencies..."
sudo apt --fix-broken install -y

echo
echo "Done. Restart Quickshell/Pikabar."
